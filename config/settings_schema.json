[
  {
    "name": "theme_info",
    "theme_name": "Relights Smart Lighting",
    "theme_version": "1.0.0",
    "theme_author": "Relights Team",
    "theme_documentation_url": "https://github.com/Nishant-sprit/relights",
    "theme_support_url": "https://github.com/Nishant-sprit/relights"
  },
  {
    "name": "Colors & Lighting Glow",
    "settings": [
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary Accent (Amber Glow)",
        "default": "#f59e0b"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Secondary Accent (Cyan Light)",
        "default": "#06b6d4"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background Dark Base",
        "default": "#0b0f17"
      },
      {
        "type": "color",
        "id": "color_card_bg",
        "label": "Card Glassmorphism Background",
        "default": "#151c28"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Primary Text",
        "default": "#f8fafc"
      }
    ]
  },
  {
    "name": "Header & Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Store Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 5,
        "default": 140,
        "unit": "px",
        "label": "Logo Width"
      },
      {
        "type": "checkbox",
        "id": "enable_sticky_header",
        "label": "Enable Sticky Header",
        "default": true
      }
    ]
  },
  {
    "name": "Cart & Checkout",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "options": [
          { "value": "drawer", "label": "Slide-out Drawer" },
          { "value": "page", "label": "Page" }
        ],
        "default": "drawer",
        "label": "Cart Type"
      },
      {
        "type": "checkbox",
        "id": "show_free_shipping_bar",
        "label": "Show Free Shipping Progress Bar",
        "default": true
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free Shipping Threshold ($)",
        "default": 99
      }
    ]
  },
  {
    "name": "Social Media Links",
    "settings": [
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube URL"
      }
    ]
  }
]
