<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="text-center max-w-2xl mx-auto mb-12 space-y-2">
    <span class="text-xs font-bold uppercase tracking-[0.2em] text-blue-500">
      Engineered Excellence
    </span>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight">
      Designed for Modern Homes & Safety
    </h2>
    <p class="text-sm text-gray-500">
      Every LuminaStep component is built with precision for lifelong reliability.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    
    <div class="p-6 rounded-3xl bg-white border border-gray-100 hover:border-gray-200 shadow-sm hover:shadow-md transition-all group space-y-3">
      <div class="w-12 h-12 rounded-2xl bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-500 group-hover:scale-105 transition-transform">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
      </div>
      <h4 class="text-base font-bold text-gray-900">Precision Motion Detection</h4>
      <p class="text-xs text-gray-500 leading-relaxed">Dual top & bottom PIR + Microwave sensors track approaching movement with sub-degree accuracy.</p>
    </div>

    <div class="p-6 rounded-3xl bg-white border border-gray-100 hover:border-gray-200 shadow-sm hover:shadow-md transition-all group space-y-3">
      <div class="w-12 h-12 rounded-2xl bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-500 group-hover:scale-105 transition-transform">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
      </div>
      <h4 class="text-base font-bold text-gray-900">Automatic On/Off Cascade</h4>
      <p class="text-xs text-gray-500 leading-relaxed">Lights sequence smoothly step-by-step in your walk direction, fading off gently.</p>
    </div>

    <div class="p-6 rounded-3xl bg-white border border-gray-100 hover:border-gray-200 shadow-sm hover:shadow-md transition-all group space-y-3">
      <div class="w-12 h-12 rounded-2xl bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-500 group-hover:scale-105 transition-transform">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
      <h4 class="text-base font-bold text-gray-900">Energy Saving Smart Photocell</h4>
      <p class="text-xs text-gray-500 leading-relaxed">Built-in daylight sensor keeps lights off during bright daytime hours, saving up to 85% energy.</p>
    </div>

    <div class="p-6 rounded-3xl bg-white border border-gray-100 hover:border-gray-200 shadow-sm hover:shadow-md transition-all group space-y-3">
      <div class="w-12 h-12 rounded-2xl bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-500 group-hover:scale-105 transition-transform">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
      <h4 class="text-base font-bold text-gray-900">Plug & Play Installation</h4>
      <p class="text-xs text-gray-500 leading-relaxed">Pre-cut COB LED strips and color-coded quick-snap harnesses require zero wire splicing.</p>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Feature Grid",
  "settings": [],
  "presets": [
    {
      "name": "Feature Grid"
    }
  ]
}
{% endschema %}
