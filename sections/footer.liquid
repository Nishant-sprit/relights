<footer class="border-t border-slate-800 bg-slate-950 text-slate-400 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      
      <div>
        <h3 class="text-xl font-extrabold text-slate-100 mb-4">RELIGHTS<span class="text-amber-400">.</span></h3>
        <p class="text-sm text-slate-400">Premium smart staircase and architectural accent lighting designed for modern automated luxury spaces.</p>
      </div>

      <div>
        <h4 class="text-sm font-bold text-slate-200 uppercase tracking-wider mb-4">Navigation</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="hover:text-amber-400">Home</a></li>
          <li><a href="/collections/all" class="hover:text-amber-400">Shop All Lights</a></li>
          <li><a href="#simulator" class="hover:text-amber-400">Stair Simulator</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-bold text-slate-200 uppercase tracking-wider mb-4">Support & Wiring</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="#wiring-guide" class="hover:text-amber-400">Wiring & Installation Guide</a></li>
          <li><a href="/pages/contact" class="hover:text-amber-400">Contact Technical Team</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-bold text-slate-200 uppercase tracking-wider mb-4">Newsletter</h4>
        <p class="text-xs text-slate-400 mb-3">Subscribe for lighting design tips and software updates.</p>
        <form method="post" action="/contact#contact_form" class="flex gap-2">
          <input type="email" name="contact[email]" placeholder="Your email address..." required class="bg-slate-900 border border-slate-800 rounded-xl px-3 py-2 text-sm text-slate-100 w-full focus:outline-none focus:border-amber-500">
          <button type="submit" class="bg-amber-500 text-slate-950 font-bold px-4 py-2 rounded-xl hover:bg-amber-400 transition-colors">Join</button>
        </form>
      </div>

    </div>

    <div class="border-t border-slate-900 pt-6 text-center text-xs text-slate-500">
      &copy; {{ 'now' | date: "%Y" }} Relights Smart Staircase Lighting. All rights reserved. Powered by Shopify.
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
