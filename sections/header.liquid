<!-- Top Moving Announcement Marquee Bar -->
<div id="top-announcement-bar" class="bg-white text-slate-900 border-b border-slate-200/80 py-2 overflow-hidden select-none shadow-2xs">
  <div class="animate-marquee whitespace-nowrap text-xs font-bold tracking-tight flex items-center">
    {% for i in (1..4) %}
      <div class="flex items-center gap-8 shrink-0 px-4">
        <span>Welcome Offer – Get 5% Off Your First Order | Use Code: <span class="text-blue-600 font-black">RELIGHTS5</span></span>
        <span class="text-slate-400 font-bold">•</span>
        <span>Free Priority Express Worldwide Shipping on All Relights Smart Controller Orders</span>
        <span class="text-slate-400 font-bold">•</span>
        <span>Smart Motion Lighting Solutions for Safe, Intelligent Staircases</span>
        <span class="text-slate-400 font-bold">•</span>
      </div>
    {% endfor %}
  </div>
</div>

<!-- Main Sticky Header -->
<header id="main-navigation-header" class="sticky top-0 z-40 transition-all duration-300 bg-white/95 backdrop-blur-md border-b border-slate-100 py-3.5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
    
    <!-- Brand Logo -->
    <a href="{{ routes.root_url }}" class="flex items-center gap-2.5 text-left group cursor-pointer focus:outline-none">
      <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center text-white shadow-md shadow-blue-500/20 group-hover:scale-105 transition-transform">
        <div class="w-3 h-3 bg-white rounded-full shadow-lg"></div>
      </div>
      <div>
        <span class="text-xl font-bold tracking-tight text-slate-800 group-hover:text-blue-600 transition-colors">
          Relights
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Menu -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-semibold">
      <a href="{{ routes.root_url }}" class="transition-colors py-1 relative {% if request.path == '/' %}text-blue-600 border-b-2 border-blue-600{% else %}text-slate-600 hover:text-slate-900{% endif %}">
        Home
      </a>
      <a href="{{ routes.all_products_collection_url }}" class="transition-colors py-1 relative {% if request.path contains '/collections' or request.path contains '/products' %}text-blue-600 border-b-2 border-blue-600{% else %}text-slate-600 hover:text-slate-900{% endif %}">
        Products
      </a>
      <a href="/pages/about" class="transition-colors py-1 relative {% if request.path contains '/about' %}text-blue-600 border-b-2 border-blue-600{% else %}text-slate-600 hover:text-slate-900{% endif %}">
        About Us
      </a>
      <a href="/pages/contact" class="transition-colors py-1 relative {% if request.path contains '/contact' %}text-blue-600 border-b-2 border-blue-600{% else %}text-slate-600 hover:text-slate-900{% endif %}">
        Contact
      </a>
    </nav>

    <!-- Right Header Actions (Search & Cart Drawer) -->
    <div class="flex items-center gap-3">
      <!-- Search Button Trigger -->
      <button type="button" id="HeaderSearchTrigger" class="p-2 text-slate-600 hover:text-blue-600 hover:bg-slate-100 rounded-lg transition-colors cursor-pointer" title="Search Store">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </button>

      <!-- Cart Button Drawer Trigger -->
      <button data-action="open-cart" class="p-2 text-slate-700 hover:text-blue-600 hover:bg-slate-100 rounded-lg transition-colors relative cursor-pointer flex items-center gap-1.5" title="Shopping Cart">
        <div class="relative">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
          <span class="cart-count-badge absolute -top-1.5 -right-1.5 w-4 h-4 bg-blue-600 text-white text-[10px] font-bold rounded-full flex items-center justify-center animate-pulse">
            {{ cart.item_count }}
          </span>
        </div>
        <span class="hidden lg:inline text-xs font-semibold text-slate-700">
          Cart
        </span>
      </button>
    </div>

  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
