<!-- Top Floating Announcement Bar -->
<div id="top-announcement-bar" class="bg-white text-slate-900 border-b border-slate-200/80 py-2 overflow-hidden select-none">
  <div class="animate-marquee whitespace-nowrap text-xs font-bold tracking-tight flex items-center justify-around px-4">
    <span>Welcome Offer – Get 10% Off Your First Order | Use Code: <span class="text-blue-600 font-black">RELIGHTS10</span></span>
    <span class="text-slate-400 font-bold">•</span>
    <span>Free Priority Express Worldwide Shipping on All Relights Smart Controller Orders</span>
    <span class="text-slate-400 font-bold">•</span>
    <span>Smart Motion Lighting Solutions for Safe, Intelligent Staircases</span>
  </div>
</div>

<!-- Main Header -->
<header class="sticky top-0 z-40 w-full border-b border-slate-100 bg-white/95 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2.5 text-xl font-bold tracking-tight text-slate-800 group">
          <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white shadow-md shadow-blue-500/20 group-hover:scale-105 transition-transform">
            <div class="w-3 h-3 bg-white rounded-full"></div>
          </div>
          <span class="text-slate-900 font-extrabold text-2xl tracking-tight">RELIGHTS</span>
        </a>
      </div>

      <!-- Navigation Links -->
      <nav class="hidden md:flex items-center space-x-8 text-sm font-semibold text-slate-600">
        {% for link in linklists.main-menu.links %}
          <a href="{{ link.url }}" class="hover:text-blue-600 transition-colors py-1">
            {{ link.title }}
          </a>
        {% else %}
          <a href="/" class="text-blue-600 font-bold">Home</a>
          <a href="/collections/all" class="hover:text-blue-600 transition-colors">Products</a>
          <a href="/pages/about" class="hover:text-blue-600 transition-colors">About Us</a>
          <a href="/pages/contact" class="hover:text-blue-600 transition-colors">Contact</a>
        {% endfor %}
      </nav>

      <!-- Cart & Wishlist -->
      <div class="flex items-center gap-3">
        <a href="/collections/all" class="p-2 text-slate-600 hover:text-blue-600 hover:bg-slate-100 rounded-lg transition-colors relative">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
          </svg>
          <span class="absolute top-1 right-1 w-4 h-4 bg-rose-500 text-white text-[10px] font-bold rounded-full flex items-center justify-center">0</span>
        </a>

        <button id="OpenCartDrawerBtn" class="p-2 text-slate-700 hover:text-blue-600 hover:bg-slate-100 rounded-lg transition-colors relative flex items-center gap-1.5">
          <div class="relative">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
            </svg>
            <span class="cart-count-badge absolute -top-1.5 -right-1.5 w-4 h-4 rounded-full bg-blue-600 text-white font-bold text-[10px] flex items-center justify-center">
              {{ cart.item_count }}
            </span>
          </div>
          <span class="hidden lg:inline text-xs font-semibold text-slate-700">Cart</span>
        </button>
      </div>

    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Main Navigation Menu"
    }
  ]
}
{% endschema %}
