<div id="hero-carousel" class="relative w-full min-h-[560px] sm:min-h-[640px] lg:min-h-[720px] bg-slate-950 text-white overflow-hidden flex flex-col justify-between group select-none">
  
  <!-- Background Image with Dark Vignette Gradient -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=2000&q=80"
      alt="Relights Smart Motion Staircase Lighting"
      width="2000"
      height="1200"
      class="w-full h-full object-cover object-center scale-105 transition-transform duration-1000 ease-out"
    >
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/95 via-slate-950/80 to-slate-950/40"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-slate-950/60"></div>
  </div>

  <!-- Hero Content -->
  <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 sm:pt-24 pb-12 w-full my-auto space-y-6">
    
    <!-- Top Pill Badge -->
    <div class="flex flex-wrap items-center gap-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-blue-500/20 text-blue-300 border border-blue-400/30 backdrop-blur-md">
        <svg class="w-3.5 h-3.5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        <span>NEW: GEN 3 MOTION CONTROLLER</span>
      </span>
      <span class="hidden sm:inline-flex items-center gap-1 px-3 py-1 rounded-full text-[11px] font-semibold text-slate-300 bg-slate-900/80 border border-slate-800">
        Dual PIR Motion Activation
      </span>
    </div>

    <!-- Title & Description -->
    <div class="max-w-3xl space-y-4">
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black text-white tracking-tight leading-[1.08]">
        Smart Lighting for <br>
        <span class="bg-gradient-to-r from-blue-400 via-sky-300 to-indigo-400 bg-clip-text text-transparent">
          Every Step.
        </span>
      </h1>
      <p class="text-sm sm:text-base lg:text-lg text-slate-300 max-w-2xl leading-relaxed font-normal">
        Experience ultimate safety and luxury with the Relights Intelligent Motion Controller. Automatically illuminate your staircase with seamless step-by-step cascading motion sensing.
      </p>
    </div>

    <!-- Call to Action Buttons -->
    <div class="flex flex-wrap items-center gap-4 pt-2">
      <a href="/products/32-channel-stair-led-controller" class="px-7 py-3.5 rounded-2xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-blue-600/30 hover:shadow-blue-500/50 transition-all transform hover:-translate-y-0.5 flex items-center gap-2 cursor-pointer">
        <span>View Product Details &rarr;</span>
      </a>
    </div>

    <!-- Features Bar Below CTAs -->
    <div class="pt-6 border-t border-slate-800/80 grid grid-cols-3 sm:flex items-center gap-6 text-slate-300 text-xs font-medium">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <span>Free Shipping</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        <span>2-Year Warranty</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
        <span>30-Day Money Back</span>
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Hero Banner",
  "settings": []
}
{% endschema %}
