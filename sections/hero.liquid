<section class="relative bg-slate-950 text-white min-h-[580px] flex items-center justify-center overflow-hidden py-16 px-4 sm:px-6 lg:px-8">
  <!-- Background Image Overlay -->
  <div class="absolute inset-0 z-0">
    <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=2000&q=80" alt="Smart Architectural Lighting Staircase" class="w-full h-full object-cover opacity-35 filter brightness-75 scale-105">
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-slate-950/30"></div>
  </div>

  <div class="relative z-10 max-w-4xl mx-auto text-center space-y-6">
    <!-- Badges -->
    <div class="flex flex-wrap items-center justify-center gap-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-500/20 text-blue-300 text-xs font-bold border border-blue-400/30 backdrop-blur-sm">
        ✨ NEW: GEN 3 MOTION CONTROLLER
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-600 text-white text-xs font-bold shadow-md shadow-blue-500/30">
        ⚡ Dual PIR Motion Activation
      </span>
    </div>

    <!-- Main Title -->
    <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-white leading-tight drop-shadow-md">
      Smart Lighting for <br class="hidden sm:inline">
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-blue-300 to-indigo-300">Every Step.</span>
    </h1>

    <!-- Subtitle -->
    <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto leading-relaxed font-normal">
      Experience ultimate safety and luxury with the Relights Intelligent Motion Controller. Automatically illuminate your staircase with seamless step-by-step cascading motion sensing.
    </p>

    <!-- Call to action button -->
    <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="/collections/all" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-500 text-white text-xs font-extrabold px-8 py-4 rounded-xl shadow-lg shadow-blue-600/30 transition-all hover:scale-105">
        <span>View Product Details</span>
        <span>&rarr;</span>
      </a>
    </div>

    <!-- Feature Badges -->
    <div class="pt-6 border-t border-slate-800/80 flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-xs font-bold text-slate-300">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-blue-400"></span>
        <span>Free Shipping</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-blue-400"></span>
        <span>2-Year Warranty</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-blue-400"></span>
        <span>30-Day Money Back</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": []
}
{% endschema %}
