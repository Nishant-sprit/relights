<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 bg-gray-50 rounded-3xl border border-gray-100 my-12">
  <div class="text-center max-w-2xl mx-auto mb-12 space-y-2">
    <span class="text-xs font-bold uppercase tracking-[0.2em] text-blue-500">
      Simple & Smart Logic
    </span>
    <h2 class="text-3xl font-extrabold text-gray-900">How LuminaStep™ Works</h2>
    <p class="text-sm text-gray-500">
      Automatic hands-free lighting in three seamless stages.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
    
    <!-- Step 1 -->
    <div class="p-8 rounded-3xl bg-white border border-gray-100 shadow-sm space-y-4 text-center relative z-10">
      <div class="w-12 h-12 rounded-2xl bg-[#111111] text-white font-bold text-lg flex items-center justify-center mx-auto shadow-md">
        1
      </div>
      <h3 class="text-lg font-bold text-gray-900">Detect Motion</h3>
      <p class="text-xs text-gray-500 leading-relaxed">
        As you step within 3.5 meters of top or bottom landing, precision radar motion sensors immediately detect your arrival.
      </p>
    </div>

    <!-- Step 2 -->
    <div class="p-8 rounded-3xl bg-white border border-gray-100 shadow-sm space-y-4 text-center relative z-10">
      <div class="w-12 h-12 rounded-2xl bg-blue-500 text-white font-bold text-lg flex items-center justify-center mx-auto shadow-md shadow-blue-500/30">
        2
      </div>
      <h3 class="text-lg font-bold text-gray-900">Cascading Light Sequence</h3>
      <p class="text-xs text-gray-500 leading-relaxed">
        Step lights illuminate sequentially in your direction of travel in a soft cascading ripple effect.
      </p>
    </div>

    <!-- Step 3 -->
    <div class="p-8 rounded-3xl bg-white border border-gray-100 shadow-sm space-y-4 text-center relative z-10">
      <div class="w-12 h-12 rounded-2xl bg-[#111111] text-white font-bold text-lg flex items-center justify-center mx-auto shadow-md">
        3
      </div>
      <h3 class="text-lg font-bold text-gray-900">Turn Off After Delay</h3>
      <p class="text-xs text-gray-500 leading-relaxed">
        After you complete your climb, the lights gently dim and switch off automatically after your preset delay time.
      </p>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "How It Works",
  "settings": [],
  "presets": [
    {
      "name": "How It Works"
    }
  ]
}
{% endschema %}
