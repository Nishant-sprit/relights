<div id="CartDrawer" class="fixed inset-y-0 right-0 w-full max-w-md bg-neutral-900 border-l border-neutral-800 h-full flex flex-col z-50 shadow-2xl transform translate-x-full transition-transform duration-300">
  
  <!-- Drawer Header -->
  <div class="p-6 border-b border-neutral-800 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
      <h3 class="text-lg font-bold text-white">Your Shopping Cart</h3>
      <span class="cart-count-badge text-xs bg-neutral-800 text-neutral-300 px-2.5 py-0.5 rounded-full font-mono font-bold">
        {{ cart.item_count }}
      </span>
    </div>
    <button data-action="close-cart" class="p-2 rounded-xl text-neutral-400 hover:text-white hover:bg-neutral-800 transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>

  <!-- Free Shipping Progress Indicator -->
  <div class="bg-neutral-950 px-6 py-3.5 border-b border-neutral-800">
    <div id="ShippingProgressText" class="text-xs mb-2 font-medium text-neutral-300">
      {%- assign threshold = 15000 -%}
      {%- if cart.total_price < threshold -%}
        {%- assign remaining = threshold | minus: cart.total_price -%}
        Add <strong class="text-blue-400 font-mono">{{ remaining | money }}</strong> more for <strong class="text-white">Free Express Shipping</strong>
      {%- else -%}
        <span class="text-green-400 font-bold">✓ You qualify for FREE Express Shipping!</span>
      {%- endif -%}
    </div>
    <div class="w-full bg-neutral-800 h-2 rounded-full overflow-hidden">
      {%- assign percent = cart.total_price | times: 100 | divided_by: threshold -%}
      {%- if percent > 100 -%}{%- assign percent = 100 -%}{%- endif -%}
      <div id="ShippingProgressBar" class="bg-gradient-to-r from-blue-600 to-blue-400 h-full transition-all duration-300" style="width: {{ percent }}%;"></div>
    </div>
  </div>

  <!-- Cart Items List Container -->
  <div id="CartDrawerItems" class="flex-1 overflow-y-auto p-6 space-y-4">
    {%- if cart.item_count == 0 -%}
      <div class="text-center py-16 space-y-4">
        <div class="w-16 h-16 rounded-2xl bg-neutral-800 border border-neutral-700 flex items-center justify-center mx-auto text-neutral-500">
          <svg class="w-8 h-8 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
        </div>
        <div class="space-y-1">
          <h4 class="text-base font-bold text-white">Your cart is currently empty</h4>
          <p class="text-xs text-neutral-400">Discover our smart motion lighting kits and elevate your home.</p>
        </div>
        <button data-action="close-cart" class="px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs shadow-lg shadow-blue-600/30 transition-all">
          Browse Products &rarr;
        </button>
      </div>
    {%- else -%}
      {%- for item in cart.items -%}
        <div class="p-4 rounded-xl bg-neutral-950 border border-neutral-800 flex gap-4 transition-all items-center">
          <img src="{{ item.image | image_url: width: 150 }}" alt="{{ item.title | escape }}" width="64" height="64" class="w-16 h-16 object-cover rounded-xl border border-neutral-800 bg-neutral-900 shrink-0">
          
          <div class="flex-1 space-y-1">
            <div class="flex justify-between items-start">
              <h4 class="text-sm font-bold text-white leading-snug line-clamp-1">
                {{ item.product.title }}
              </h4>
              <button class="text-neutral-500 hover:text-red-400 p-1 transition-colors ml-2" onclick="changeQuantity('{{ item.key }}', 0)" title="Remove item">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              </button>
            </div>

            <p class="text-xs text-neutral-400 font-medium">{{ item.variant.title }}</p>

            <div class="flex items-center justify-between pt-2 border-t border-neutral-800/80 mt-2">
              <!-- Quantity Controls -->
              <div class="flex items-center bg-neutral-900 border border-neutral-700 rounded-lg p-0.5">
                <button class="w-7 h-7 bg-neutral-800 hover:bg-neutral-700 text-white font-bold text-sm flex items-center justify-center rounded transition-colors cursor-pointer" onclick="changeQuantity('{{ item.key }}', {{ item.quantity | minus: 1 }})">-</button>
                <span class="px-3 text-xs font-mono font-bold text-white">{{ item.quantity }}</span>
                <button class="w-7 h-7 bg-neutral-800 hover:bg-neutral-700 text-white font-bold text-sm flex items-center justify-center rounded transition-colors cursor-pointer" onclick="changeQuantity('{{ item.key }}', {{ item.quantity | plus: 1 }})">+</button>
              </div>

              <span class="text-sm font-bold text-blue-400 font-mono">{{ item.final_line_price | money }}</span>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  <!-- Footer Checkout Summary -->
  <div class="p-6 border-t border-neutral-800 bg-neutral-950 space-y-4">
    <div class="space-y-2 text-xs text-neutral-400 font-sans">
      <div class="flex justify-between">
        <span>Subtotal</span>
        <span id="CartSubtotalAmount" class="text-white font-mono font-bold text-sm">{{ cart.total_price | money }}</span>
      </div>
      <div class="flex justify-between">
        <span>Estimated Express Shipping</span>
        <span class="text-white font-mono font-bold">
          {%- if cart.total_price >= 15000 or cart.total_price == 0 -%}FREE{%- else -%}$15.00{%- endif -%}
        </span>
      </div>
      <div class="flex justify-between text-base font-bold text-white pt-3 border-t border-neutral-800">
        <span>Total</span>
        <span id="CartTotalAmount" class="text-blue-400 font-mono font-bold text-lg">{{ cart.total_price | money }}</span>
      </div>
    </div>

    <!-- Native Shopify Checkout Button -->
    <a href="/checkout" class="w-full py-4 bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm rounded-xl transition-all shadow-xl shadow-blue-600/30 flex items-center justify-center gap-2">
      <span>Proceed to Checkout</span>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
    </a>

    <div class="flex items-center justify-center gap-2 text-[11px] text-neutral-400">
      <svg class="w-3.5 h-3.5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
      <span>256-Bit SSL Encrypted Checkout</span>
    </div>
  </div>

</div>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": []
}
{% endschema %}
