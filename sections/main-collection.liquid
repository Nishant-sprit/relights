<!-- Collection Header -->
<div class="py-12 bg-white text-center border-b border-gray-100 px-4">
  <div class="max-w-4xl mx-auto space-y-3">
    <span class="text-xs font-black text-blue-600 uppercase tracking-widest block">
      SMART MOTION LIGHTING CATALOG
    </span>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight">
      {{ collection.title | default: 'Smart Motion Lighting Systems' }}
    </h1>
    <p class="text-xs sm:text-sm text-gray-500 max-w-2xl mx-auto">
      Explore complete ready-to-install packages engineered for safety, energy savings, and luxury appeal.
    </p>
  </div>
</div>

<section class="py-10 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-8">
  
  <!-- Filter & Sort Bar (Matching Screenshot) -->
  <div class="p-4 rounded-3xl bg-neutral-950 text-white border border-neutral-800 flex flex-wrap items-center justify-between gap-4 shadow-xl">
    
    <!-- Category Pills -->
    <div class="flex flex-wrap items-center gap-2 text-xs font-bold">
      <button type="button" class="filter-category-btn px-4 py-2 rounded-xl bg-blue-600 text-white shadow-sm transition-all" data-tag="all">
        All Kits
      </button>
      <button type="button" class="filter-category-btn px-4 py-2 rounded-xl bg-neutral-900 hover:bg-neutral-800 text-neutral-300 transition-all" data-tag="hardwire">
        Hardwire Pro Cascading Kits
      </button>
      <button type="button" class="filter-category-btn px-4 py-2 rounded-xl bg-neutral-900 hover:bg-neutral-800 text-neutral-300 transition-all" data-tag="wireless">
        Wireless Stick-On Kits
      </button>
      <button type="button" class="filter-category-btn px-4 py-2 rounded-xl bg-neutral-900 hover:bg-neutral-800 text-neutral-300 transition-all" data-tag="recessed">
        In-Wall Recessed Spotlights
      </button>
    </div>

    <!-- Right Controls: Price & Sort -->
    <div class="flex items-center gap-6 text-xs font-mono">
      <div class="hidden sm:flex items-center gap-2 text-neutral-400">
        <span>Max Price:</span>
        <input type="range" id="priceRangeFilter" min="1000" max="30000" value="30000" class="w-24 accent-blue-500 cursor-pointer">
        <span id="priceRangeValue" class="text-white font-bold">₹30,000</span>
      </div>

      <div class="flex items-center gap-2">
        <span class="text-neutral-400 font-sans">Sort:</span>
        <select id="CollectionSortBy" class="bg-neutral-900 text-white font-bold px-3 py-2 rounded-xl border border-neutral-800 focus:outline-none cursor-pointer">
          <option value="manual">Featured First</option>
          <option value="price-ascending">Price: Low to High</option>
          <option value="price-descending">Price: High to Low</option>
          <option value="title-ascending">Alphabetical</option>
        </select>
      </div>
    </div>

  </div>

  <!-- Dynamic Product Grid (Fetching dynamically from Shopify Backend!) -->
  <div id="DynamicProductCatalogGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {%- if collection.products.size > 0 -%}
      {%- paginate collection.products by 12 -%}
        {%- for product in collection.products -%}
          <div class="product-catalog-card p-5 rounded-3xl bg-neutral-950 text-white border border-neutral-800 flex flex-col justify-between space-y-4 hover:border-neutral-700 transition-all shadow-xl group">
            
            <div class="space-y-4">
              <!-- Product Card Image -->
              <div class="aspect-square bg-neutral-900 rounded-2xl overflow-hidden relative border border-neutral-800">
                
                <!-- Dynamic Badge Tag -->
                {%- if product.tags contains 'Bestseller' or product.tags contains 'Best Seller' -%}
                  <span class="absolute top-3 left-3 bg-blue-600 text-white text-[9px] font-black px-2.5 py-1 rounded-full uppercase tracking-wider z-10">
                    AMAZON CHOICE | BESTSELLER
                  </span>
                {%- elsif product.tags contains 'Premium' -%}
                  <span class="absolute top-3 left-3 bg-indigo-600 text-white text-[9px] font-black px-2.5 py-1 rounded-full uppercase tracking-wider z-10">
                    PREMIUM PICK
                  </span>
                {%- elsif product.tags contains 'Architectural' -%}
                  <span class="absolute top-3 left-3 bg-blue-500 text-white text-[9px] font-black px-2.5 py-1 rounded-full uppercase tracking-wider z-10">
                    ARCHITECTURAL CHOICE
                  </span>
                {%- else -%}
                  <span class="absolute top-3 left-3 bg-neutral-800 text-white text-[9px] font-black px-2.5 py-1 rounded-full uppercase tracking-wider z-10 border border-neutral-700">
                    SMART LIGHTING
                  </span>
                {%- endif -%}

                <a href="{{ product.url }}" class="block w-full h-full">
                  {%- if product.featured_image != blank -%}
                    <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" width="800" height="800" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                  {%- else -%}
                    <img src="https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&q=80&w=800" alt="{{ product.title | escape }}" width="800" height="800" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                  {%- endif -%}
                </a>
              </div>

              <!-- Title & Subtitle -->
              <div class="space-y-1">
                <h3 class="text-base font-bold text-white leading-snug line-clamp-1 group-hover:text-blue-400 transition-colors">
                  <a href="{{ product.url }}">{{ product.title }}</a>
                </h3>
                <p class="text-xs text-neutral-400 line-clamp-2">
                  {{ product.description | strip_html | truncate: 110 | default: 'Automatic step lighting system with dual motion sensors.' }}
                </p>
              </div>

              <!-- Key Bullet Highlights -->
              <ul class="text-[11px] text-neutral-400 space-y-1 pt-1">
                <li class="flex items-center gap-1.5">
                  <span class="text-blue-400 font-bold">•</span>
                  <span>Dual PIR motion sensors (Port A & Port B)</span>
                </li>
                <li class="flex items-center gap-1.5">
                  <span class="text-blue-400 font-bold">•</span>
                  <span>Automatic sequential cascade illumination effect</span>
                </li>
              </ul>
            </div>

            <!-- Bottom Price & Actions Bar -->
            <div class="pt-4 border-t border-neutral-900 flex items-center justify-between">
              <div>
                <div class="flex items-baseline gap-2">
                  <span class="text-lg font-black text-white font-mono">
                    ₹{{ product.price | money_without_currency }}
                  </span>
                  {%- if product.compare_at_price > product.price -%}
                    <span class="text-xs text-neutral-500 line-through font-mono">
                      ₹{{ product.compare_at_price | money_without_currency }}
                    </span>
                  {%- endif -%}
                </div>
                <div class="flex items-center text-amber-400 text-[10px] font-bold mt-0.5">
                  <span>★ 4.8</span>
                  <span class="text-neutral-500 ml-1">(342)</span>
                </div>
              </div>

              <div class="flex items-center gap-2">
                <a href="{{ product.url }}" class="px-4 py-2 bg-neutral-900 hover:bg-neutral-800 text-white text-xs font-bold rounded-xl border border-neutral-800 transition-all">
                  Configure
                </a>

                {% form 'product', product %}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <button type="submit" class="p-2 bg-blue-600 hover:bg-blue-500 text-white rounded-xl shadow-lg transition-all cursor-pointer" title="Add to Cart">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                  </button>
                {% endform %}
              </div>
            </div>

          </div>
        {%- endfor -%}
      {%- endpaginate -%}
    {%- else -%}
      {%- paginate collections.all.products by 12 -%}
        {%- for product in collections.all.products -%}
          <div class="product-catalog-card p-5 rounded-3xl bg-neutral-950 text-white border border-neutral-800 flex flex-col justify-between space-y-4 hover:border-neutral-700 transition-all shadow-xl group">
            
            <div class="space-y-4">
              <!-- Product Card Image -->
              <div class="aspect-square bg-neutral-900 rounded-2xl overflow-hidden relative border border-neutral-800">
                
                <!-- Dynamic Badge Tag -->
                {%- if product.tags contains 'Bestseller' or product.tags contains 'Best Seller' -%}
                  <span class="absolute top-3 left-3 bg-blue-600 text-white text-[9px] font-black px-2.5 py-1 rounded-full uppercase tracking-wider z-10">
                    AMAZON CHOICE | BESTSELLER
                  </span>
                {%- elsif product.tags contains 'Premium' -%}
                  <span class="absolute top-3 left-3 bg-indigo-600 text-white text-[9px] font-black px-2.5 py-1 rounded-full uppercase tracking-wider z-10">
                    PREMIUM PICK
                  </span>
                {%- elsif product.tags contains 'Architectural' -%}
                  <span class="absolute top-3 left-3 bg-blue-500 text-white text-[9px] font-black px-2.5 py-1 rounded-full uppercase tracking-wider z-10">
                    ARCHITECTURAL CHOICE
                  </span>
                {%- else -%}
                  <span class="absolute top-3 left-3 bg-neutral-800 text-white text-[9px] font-black px-2.5 py-1 rounded-full uppercase tracking-wider z-10 border border-neutral-700">
                    SMART LIGHTING
                  </span>
                {%- endif -%}

                <a href="{{ product.url }}" class="block w-full h-full">
                  {%- if product.featured_image != blank -%}
                    <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" width="800" height="800" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                  {%- else -%}
                    <img src="https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&q=80&w=800" alt="{{ product.title | escape }}" width="800" height="800" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                  {%- endif -%}
                </a>
              </div>

              <!-- Title & Subtitle -->
              <div class="space-y-1">
                <h3 class="text-base font-bold text-white leading-snug line-clamp-1 group-hover:text-blue-400 transition-colors">
                  <a href="{{ product.url }}">{{ product.title }}</a>
                </h3>
                <p class="text-xs text-neutral-400 line-clamp-2">
                  {{ product.description | strip_html | truncate: 110 | default: 'Automatic step lighting system with dual motion sensors.' }}
                </p>
              </div>

              <!-- Key Bullet Highlights -->
              <ul class="text-[11px] text-neutral-400 space-y-1 pt-1">
                <li class="flex items-center gap-1.5">
                  <span class="text-blue-400 font-bold">•</span>
                  <span>Dual PIR motion sensors (Port A & Port B)</span>
                </li>
                <li class="flex items-center gap-1.5">
                  <span class="text-blue-400 font-bold">•</span>
                  <span>Automatic sequential cascade illumination effect</span>
                </li>
              </ul>
            </div>

            <!-- Bottom Price & Actions Bar -->
            <div class="pt-4 border-t border-neutral-900 flex items-center justify-between">
              <div>
                <div class="flex items-baseline gap-2">
                  <span class="text-lg font-black text-white font-mono">
                    ₹{{ product.price | money_without_currency }}
                  </span>
                  {%- if product.compare_at_price > product.price -%}
                    <span class="text-xs text-neutral-500 line-through font-mono">
                      ₹{{ product.compare_at_price | money_without_currency }}
                    </span>
                  {%- endif -%}
                </div>
                <div class="flex items-center text-amber-400 text-[10px] font-bold mt-0.5">
                  <span>★ 4.8</span>
                  <span class="text-neutral-500 ml-1">(342)</span>
                </div>
              </div>

              <div class="flex items-center gap-2">
                <a href="{{ product.url }}" class="px-4 py-2 bg-neutral-900 hover:bg-neutral-800 text-white text-xs font-bold rounded-xl border border-neutral-800 transition-all">
                  Configure
                </a>

                {% form 'product', product %}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <button type="submit" class="p-2 bg-blue-600 hover:bg-blue-500 text-white rounded-xl shadow-lg transition-all cursor-pointer" title="Add to Cart">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                  </button>
                {% endform %}
              </div>
            </div>

          </div>
        {%- endfor -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>

</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Interactive filter category pills
    const filterBtns = document.querySelectorAll('.filter-category-btn');
    const cards = document.querySelectorAll('.product-catalog-card');
    const priceSlider = document.getElementById('priceRangeFilter');
    const priceVal = document.getElementById('priceRangeValue');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.className = 'filter-category-btn px-4 py-2 rounded-xl bg-neutral-900 hover:bg-neutral-800 text-neutral-300 transition-all cursor-pointer');
        btn.className = 'filter-category-btn px-4 py-2 rounded-xl bg-blue-600 text-white shadow-sm transition-all cursor-pointer';
      });
    });

    if (priceSlider && priceVal) {
      priceSlider.addEventListener('input', (e) => {
        priceVal.textContent = `₹${e.target.value}`;
      });
    }
  });
</script>

{% schema %}
{
  "name": "Main Collection",
  "settings": []
}
{% endschema %}
