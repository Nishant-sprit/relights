<!-- Contact Us Hero Header -->
<div class="py-12 sm:py-16 bg-white text-center border-b border-gray-100 px-4">
  <div class="max-w-4xl mx-auto space-y-3">
    <span class="text-xs font-black text-blue-600 uppercase tracking-widest block font-mono">
      WE ARE HERE TO HELP
    </span>
    <h1 class="text-3xl sm:text-5xl font-black text-gray-900 tracking-tight">
      Contact <span class="bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">LuminaStep™ Support</span>
    </h1>
    <p class="text-xs sm:text-base text-gray-500 max-w-2xl mx-auto leading-relaxed">
      Have questions regarding step sizing, custom wiring, or bulk builder discounts? Reach out to our expert engineering team.
    </p>
  </div>
</div>

<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-12">

  <!-- Main 2-Column Grid: Form Left, Info Right -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
    
    <!-- Left Column: Send Us a Message Form -->
    <div class="lg:col-span-7 bg-neutral-950 text-white p-6 sm:p-10 rounded-3xl border border-neutral-800 shadow-2xl space-y-6">
      <div>
        <h2 class="text-2xl font-black text-white tracking-tight">Send Us a Message</h2>
        <p class="text-xs text-neutral-400 mt-1">Our support engineers typically respond within 1–2 hours.</p>
      </div>

      <form id="ContactForm" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label class="text-xs font-bold text-neutral-300 block">Full Name *</label>
            <input type="text" required placeholder="Marcus Vance" class="w-full bg-neutral-900 border border-neutral-800 rounded-xl px-4 py-3 text-xs text-white placeholder-neutral-500 focus:outline-none focus:border-blue-500 transition-colors">
          </div>

          <div class="space-y-1.5">
            <label class="text-xs font-bold text-neutral-300 block">Email Address *</label>
            <input type="email" required placeholder="marcus@example.com" class="w-full bg-neutral-900 border border-neutral-800 rounded-xl px-4 py-3 text-xs text-white placeholder-neutral-500 focus:outline-none focus:border-blue-500 transition-colors">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label class="text-xs font-bold text-neutral-300 block">Phone Number</label>
            <input type="tel" placeholder="+1 (555) 000-0000" class="w-full bg-neutral-900 border border-neutral-800 rounded-xl px-4 py-3 text-xs text-white placeholder-neutral-500 focus:outline-none focus:border-blue-500 transition-colors">
          </div>

          <div class="space-y-1.5">
            <label class="text-xs font-bold text-neutral-300 block">Subject</label>
            <select class="w-full bg-neutral-900 border border-neutral-800 rounded-xl px-4 py-3 text-xs text-white focus:outline-none focus:border-blue-500 transition-colors cursor-pointer">
              <option value="general">General Product Inquiry</option>
              <option value="technical">Technical / Wiring Support</option>
              <option value="order">Order & Shipping Status</option>
              <option value="wholesale">Bulk Builder Quote</option>
            </select>
          </div>
        </div>

        <div class="space-y-1.5">
          <label class="text-xs font-bold text-neutral-300 block">Message *</label>
          <textarea rows="5" required placeholder="How can we assist you with your staircase lighting setup..." class="w-full bg-neutral-900 border border-neutral-800 rounded-xl p-4 text-xs text-white placeholder-neutral-500 focus:outline-none focus:border-blue-500 transition-colors resize-none"></textarea>
        </div>

        <button type="submit" id="ContactSubmitBtn" class="w-full py-4 bg-blue-600 hover:bg-blue-500 text-white font-black text-xs uppercase tracking-widest rounded-xl shadow-lg shadow-blue-600/30 transition-all flex items-center justify-center gap-2 cursor-pointer">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
          <span id="ContactSubmitBtnText">Send Message</span>
        </button>
      </form>
    </div>

    <!-- Right Column: Direct Channels & Hours -->
    <div class="lg:col-span-5 space-y-6">
      
      <!-- Direct Communication Channels -->
      <div class="bg-neutral-950 text-white p-6 sm:p-8 rounded-3xl border border-neutral-800 shadow-xl space-y-6">
        <h3 class="text-lg font-black text-white tracking-tight border-b border-neutral-800 pb-4">
          Direct Communication Channels
        </h3>

        <div class="space-y-5">
          
          <!-- Toll-Free Phone -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-blue-600/20 text-blue-400 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            </div>
            <div>
              <h4 class="text-xs font-bold text-white">Toll-Free Phone Support</h4>
              <a href="tel:+18005864627" class="text-sm font-bold text-blue-400 hover:underline block">+1 (800) 586-4627</a>
              <span class="text-[10px] text-emerald-400 font-mono block mt-0.5">Mon – Sat: 8:00 AM – 8:00 PM EST</span>
            </div>
          </div>

          <!-- WhatsApp Instant -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-emerald-600/20 text-emerald-400 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
            </div>
            <div>
              <h4 class="text-xs font-bold text-white">WhatsApp Instant Support</h4>
              <a href="https://wa.me/14158903312" target="_blank" class="text-sm font-bold text-emerald-400 hover:underline block">+1 (415) 890-3312</a>
              <span class="text-[10px] text-neutral-400 block mt-0.5">Instant photo/wiring troubleshooting</span>
            </div>
          </div>

          <!-- Official Email -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-purple-600/20 text-purple-400 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <h4 class="text-xs font-bold text-white">Official Email</h4>
              <a href="mailto:support@luminastep.com" class="text-sm font-bold text-purple-400 hover:underline block">support@luminastep.com</a>
              <span class="text-[10px] text-neutral-400 block mt-0.5">24/7 Email Monitoring</span>
            </div>
          </div>

          <!-- Showroom -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-amber-600/20 text-amber-400 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div>
              <h4 class="text-xs font-bold text-white">Headquarters & Showroom</h4>
              <p class="text-xs text-neutral-300">100 Innovation Way, Suite 400<br>San Francisco, CA 94107</p>
            </div>
          </div>

        </div>
      </div>

      <!-- Business Hours Card -->
      <div class="bg-neutral-950 text-white p-6 rounded-3xl border border-neutral-800 shadow-xl space-y-3">
        <h4 class="text-xs font-bold uppercase text-neutral-400 tracking-wider flex items-center gap-2">
          <span>🕒</span> Business Hours
        </h4>
        <div class="space-y-2 text-xs font-mono pt-1">
          <div class="flex justify-between border-b border-neutral-900 pb-1.5">
            <span class="text-neutral-400">Monday – Friday:</span>
            <span class="text-white font-bold">8:00 AM – 8:00 PM EST</span>
          </div>
          <div class="flex justify-between border-b border-neutral-900 pb-1.5">
            <span class="text-neutral-400">Saturday:</span>
            <span class="text-white font-bold">9:00 AM – 5:00 PM EST</span>
          </div>
          <div class="flex justify-between text-neutral-400">
            <span>Sunday:</span>
            <span class="text-amber-400 font-bold">Closed (Emergency Email Only)</span>
          </div>
        </div>
      </div>

    </div>

  </div>

  <!-- Bottom Location Showcase Banner -->
  <div class="p-8 sm:p-12 rounded-3xl bg-neutral-950 border border-neutral-800 text-center space-y-4 shadow-2xl relative overflow-hidden">
    <div class="w-12 h-12 rounded-2xl bg-blue-600/20 text-blue-400 mx-auto flex items-center justify-center">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
    </div>
    <h3 class="text-xl sm:text-2xl font-black text-white tracking-tight">LuminaStep™ Innovation Hub</h3>
    <p class="text-xs text-neutral-400 max-w-xl mx-auto">100 Innovation Way, Suite 400, San Francisco, CA 94107</p>
    <span class="inline-block px-4 py-1.5 rounded-full bg-neutral-900 border border-neutral-800 text-neutral-300 text-[11px] font-bold">
      Interactive Staircase Display Room Open for Public Appointments
    </span>
  </div>

</section>

<!-- Form Handling JS Script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('ContactForm');
    const btnText = document.getElementById('ContactSubmitBtnText');

    if (form && btnText) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        btnText.textContent = 'Sending Message...';

        setTimeout(() => {
          btnText.textContent = '✓ Message Sent! We will reply within 2 hours.';
          form.reset();
          setTimeout(() => {
            btnText.textContent = 'Send Message';
          }, 4000);
        }, 1200);
      });
    }
  });
</script>

