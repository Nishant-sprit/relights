<!-- Pass Native Shopify Variants Data to JS -->
<script id="ShopifyVariantsJson" type="application/json">
  {{ product.variants | json }}
</script>

<!-- Interactive Product Page Logic & Tab Switcher Script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Tab Switcher Logic
    const tabBtns = document.querySelectorAll('.tab-trigger-btn');
    const tabPanes = document.querySelectorAll('.tab-pane-content');

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetTab = btn.getAttribute('data-tab');

        // Reset all buttons
        tabBtns.forEach(b => {
          b.className = 'tab-trigger-btn px-5 py-3 rounded-full hover:text-gray-900 hover:bg-gray-100 transition-all cursor-pointer text-gray-400';
        });

        // Highlight active button
        btn.className = 'tab-trigger-btn px-5 py-3 rounded-full bg-gray-900 text-white font-extrabold shadow-sm transition-all cursor-pointer';

        // Hide all tab panes
        tabPanes.forEach(pane => pane.classList.add('hidden'));

        // Show target tab pane
        const activePane = document.getElementById(`tab-content-${targetTab}`);
        if (activePane) activePane.classList.remove('hidden');
      });
    });

    // 2. Read native variants from Shopify
    let shopifyVariants = [];
    try {
      const jsonEl = document.getElementById('ShopifyVariantsJson');
      if (jsonEl) shopifyVariants = JSON.parse(jsonEl.textContent || '[]');
    } catch (e) {
      console.error('Could not parse shopify variants JSON', e);
    }

    let currency = 'INR';
    let packageType = 'full-kit';
    let activeSteps = 32;
    let quantity = 1;
    let couponApplied = false;
    let protectionPlan = false;
    let isSimulating = false;

    const INR_RATE = 83.2;

    // Elements
    const qtyInput = document.getElementById('ProductQtyInput');
    const qtyMinusBtn = document.getElementById('qty-minus');
    const qtyPlusBtn = document.getElementById('qty-plus');

    const displayUnitPrice = document.getElementById('DisplayUnitPrice');
    const displayOriginalPrice = document.getElementById('DisplayOriginalPrice');
    const stickyPrice = document.getElementById('StickyCalculatedPrice');
    const protectionCostText = document.getElementById('ProtectionCostText');
    const selectedVariantIdInput = document.getElementById('SelectedVariantId');

    const currencyInrBtn = document.getElementById('currency-inr');
    const currencyUsdBtn = document.getElementById('currency-usd');

    const couponCheck = document.getElementById('coupon-check');
    const planCheck = document.getElementById('plan-check');

    const pkgBoardBtn = document.getElementById('pkg-board');
    const pkgKitBtn = document.getElementById('pkg-kit');

    const stepBtns = document.querySelectorAll('.step-btn');
    const configStepsLabel = document.getElementById('ConfigStepsLabel');
    const simulatorStepsCount = document.getElementById('SimulatorActiveStepsCount');

    const voltageBtns = document.querySelectorAll('.voltage-btn');
    const warmthBtns = document.querySelectorAll('.warmth-btn');

    const btnTriggerBottom = document.getElementById('btn-trigger-bottom');
    const btnTriggerTop = document.getElementById('btn-trigger-top');

    // Dynamic Price Calculation strictly synced with Shopify Backend Database (INR Only)
    function calculatePrice() {
      let matchedVariant = null;
      if (shopifyVariants.length > 0) {
        if (packageType === 'controller-only') {
          matchedVariant = shopifyVariants.find(v => (v.option1 && v.option1.toLowerCase().includes('controller')) || (v.title && v.title.toLowerCase().includes('controller')) || (v.title && v.title.toLowerCase().includes('board')));
        } else {
          matchedVariant = shopifyVariants.find(v => (v.option1 && v.option1.toLowerCase().includes('kit')) || (v.title && v.title.toLowerCase().includes('kit')) || (v.title && v.title.toLowerCase().includes('complete')));
        }
        if (!matchedVariant) {
          matchedVariant = shopifyVariants[0];
        }
      }

      let basePrice = 12479;
      let origPrice = 16639;

      if (matchedVariant) {
        // Direct Shopify Backend Variant Price (in INR)
        basePrice = matchedVariant.price / 100;
        if (matchedVariant.compare_at_price && matchedVariant.compare_at_price > 0) {
          origPrice = matchedVariant.compare_at_price / 100;
        } else {
          origPrice = Math.round(basePrice * 1.25);
        }
        if (selectedVariantIdInput) selectedVariantIdInput.value = matchedVariant.id;
      } else {
        basePrice = packageType === 'full-kit' ? 12479 : 2079;
        origPrice = packageType === 'full-kit' ? 16639 : 2899;
      }

      const couponMult = couponApplied ? 0.98 : 1.0;
      const unitINR = Math.round(basePrice * couponMult) + (protectionPlan ? 830 : 0);
      const totalINR = unitINR * quantity;
      const origINR = Math.round(origPrice) * quantity;

      if (displayUnitPrice) displayUnitPrice.textContent = `₹${unitINR.toLocaleString('en-IN')}`;
      if (displayOriginalPrice) displayOriginalPrice.textContent = `₹${origINR.toLocaleString('en-IN')}`;
      if (stickyPrice) stickyPrice.textContent = `₹${totalINR.toLocaleString('en-IN')}`;
      if (protectionCostText) protectionCostText.textContent = `+₹830`;
    }

    // 3. Quantity (+ / -) Events
    if (qtyMinusBtn && qtyPlusBtn && qtyInput) {
      qtyMinusBtn.addEventListener('click', () => {
        if (quantity > 1) {
          quantity--;
          qtyInput.value = quantity;
          calculatePrice();
        }
      });
      qtyPlusBtn.addEventListener('click', () => {
        quantity++;
        qtyInput.value = quantity;
        calculatePrice();
      });
    }

    // 4. Currency Switcher Events
    if (currencyInrBtn && currencyUsdBtn) {
      currencyInrBtn.addEventListener('click', () => {
        currency = 'INR';
        currencyInrBtn.className = 'px-3 py-1 rounded-full text-xs font-bold bg-gray-900 text-white transition-all shadow-sm cursor-pointer';
        currencyUsdBtn.className = 'px-3 py-1 rounded-full text-xs font-bold bg-gray-100 text-gray-600 hover:bg-gray-200 transition-all cursor-pointer';
        calculatePrice();
      });
      currencyUsdBtn.addEventListener('click', () => {
        currency = 'USD';
        currencyUsdBtn.className = 'px-3 py-1 rounded-full text-xs font-bold bg-gray-900 text-white transition-all shadow-sm cursor-pointer';
        currencyInrBtn.className = 'px-3 py-1 rounded-full text-xs font-bold bg-gray-100 text-gray-600 hover:bg-gray-200 transition-all cursor-pointer';
        calculatePrice();
      });
    }

    // 5. Package Type Events
    if (pkgBoardBtn && pkgKitBtn) {
      pkgBoardBtn.addEventListener('click', () => {
        packageType = 'controller-only';
        pkgBoardBtn.className = 'pkg-type-btn p-3 rounded-2xl border-2 border-blue-600 bg-blue-50/60 text-blue-900 font-bold text-left transition-all shadow-sm cursor-pointer';
        pkgKitBtn.className = 'pkg-type-btn p-3 rounded-2xl border border-gray-200 text-left transition-all hover:border-gray-300 text-gray-700 cursor-pointer';
        calculatePrice();
      });
      pkgKitBtn.addEventListener('click', () => {
        packageType = 'full-kit';
        pkgKitBtn.className = 'pkg-type-btn p-3 rounded-2xl border-2 border-blue-600 bg-blue-50/60 text-blue-900 font-bold text-left transition-all shadow-sm cursor-pointer';
        pkgBoardBtn.className = 'pkg-type-btn p-3 rounded-2xl border border-gray-200 text-left transition-all hover:border-gray-300 text-gray-700 cursor-pointer';
        calculatePrice();
      });
    }

    // 6. Configure Step Count Buttons
    stepBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        stepBtns.forEach(b => b.className = 'step-btn py-1.5 px-1 rounded-xl border border-gray-200 text-center text-gray-600 cursor-pointer');
        btn.className = 'step-btn active-step py-1.5 px-1 rounded-xl border bg-gray-900 border-gray-900 text-white font-bold text-center cursor-pointer';
        
        activeSteps = parseInt(btn.getAttribute('data-steps'), 10);
        if (configStepsLabel) configStepsLabel.textContent = `${activeSteps} Steps`;
        if (simulatorStepsCount) simulatorStepsCount.textContent = `${activeSteps} Stair Steps`;
        updateSimulatorGridCount(activeSteps);
      });
    });

    function updateSimulatorGridCount(count) {
      for (let i = 0; i < 32; i++) {
        const stepEl = document.getElementById(`sim-step-${i}`);
        if (stepEl) {
          stepEl.style.display = i < count ? 'flex' : 'none';
        }
      }
    }

    // 7. Voltage Buttons
    voltageBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        voltageBtns.forEach(b => b.className = 'voltage-btn py-2 px-3 rounded-xl border border-gray-200 text-center text-gray-600 cursor-pointer');
        btn.className = 'voltage-btn active-volt py-2 px-3 rounded-xl border-2 border-blue-600 bg-blue-600 text-white font-bold text-center shadow-sm cursor-pointer';
      });
    });

    // 8. LED Warmth Buttons
    warmthBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        warmthBtns.forEach(b => b.className = 'warmth-btn py-2 px-2 rounded-xl border border-gray-200 text-center text-gray-600 cursor-pointer');
        btn.className = 'warmth-btn active-warmth py-2 px-2 rounded-xl border bg-gray-900 border-gray-900 text-white font-bold text-center cursor-pointer';
      });
    });

    // 9. Coupon & Protection Checkboxes
    if (couponCheck) {
      couponCheck.addEventListener('change', (e) => {
        couponApplied = e.target.checked;
        calculatePrice();
      });
    }
    if (planCheck) {
      planCheck.addEventListener('change', (e) => {
        protectionPlan = e.target.checked;
        calculatePrice();
      });
    }

    // 10. Controller LED Simulator Animation
    function runSim(dir) {
      if (isSimulating) return;
      isSimulating = true;

      const total = activeSteps;
      const order = dir === 'bottom' 
        ? Array.from({ length: total }, (_, i) => i)
        : Array.from({ length: total }, (_, i) => total - 1 - i);

      order.forEach((stepIdx, i) => {
        setTimeout(() => {
          const stepEl = document.getElementById(`sim-step-${stepIdx}`);
          if (stepEl) {
            stepEl.className = 'sim-step-box h-6 rounded text-[8px] font-mono flex items-center justify-center font-extrabold bg-amber-400 text-black shadow-lg scale-105 transition-all duration-150';
          }
        }, i * 100);
      });

      setTimeout(() => {
        order.forEach((stepIdx, i) => {
          setTimeout(() => {
            const stepEl = document.getElementById(`sim-step-${stepIdx}`);
            if (stepEl) {
              stepEl.className = 'sim-step-box h-6 rounded bg-gray-800 text-[8px] font-mono flex items-center justify-center text-gray-500 transition-all duration-150';
            }
          }, i * 80);
        });

        setTimeout(() => {
          isSimulating = false;
        }, order.length * 80 + 200);
      }, order.length * 100 + 1000);
    }

    // 11. Express Buy Now & Add To Cart Button Handlers
    const addToCartBtn = document.getElementById('AddToCartBtn');
    const addToCartBtnText = document.getElementById('AddToCartBtnText');
    const expressBuyNowBtn = document.getElementById('ExpressBuyNowBtn');

    if (addToCartBtn) {
      addToCartBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const variantId = selectedVariantIdInput ? selectedVariantIdInput.value : '{{ product.selected_or_first_available_variant.id }}';
        const qty = parseInt(qtyInput ? qtyInput.value : '1', 10);

        if (addToCartBtnText) addToCartBtnText.textContent = '⏳ Adding...';

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: variantId, quantity: qty })
        })
        .then(res => res.json())
        .then(() => {
          if (addToCartBtnText) addToCartBtnText.textContent = '✓ Added to Cart!';
          setTimeout(() => {
            if (addToCartBtnText) addToCartBtnText.textContent = 'Add to Cart';
          }, 2000);

          if (window.themeCart && typeof window.themeCart.openCart === 'function') {
            window.themeCart.openCart();
          } else {
            window.location.href = '/cart';
          }
        })
        .catch(err => {
          console.error(err);
          if (addToCartBtnText) addToCartBtnText.textContent = 'Add to Cart';
        });
      });
    }

    if (expressBuyNowBtn) {
      expressBuyNowBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const variantId = selectedVariantIdInput ? selectedVariantIdInput.value : '{{ product.selected_or_first_available_variant.id }}';
        const qty = parseInt(qtyInput ? qtyInput.value : '1', 10);

        expressBuyNowBtn.textContent = '⏳ Redirecting to Checkout...';

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: variantId, quantity: qty })
        })
        .then(res => res.json())
        .then(() => {
          window.location.href = '/checkout';
        })
        .catch(() => {
          window.location.href = '/checkout';
        });
      });
    }

    // Initial price calculation
    calculatePrice();
  });
</script>

