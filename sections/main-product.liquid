<!-- Breadcrumbs -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-2 text-xs text-gray-500 flex items-center gap-2">
  <a href="{{ routes.root_url }}" class="hover:text-black">Home</a>
  <span>&gt;</span>
  <a href="{{ routes.collections_url }}" class="hover:text-black">Smart Motion Lighting</a>
  <span>&gt;</span>
  <span class="text-gray-900 font-semibold">{{ product.title }}</span>
</div>

<section id="ProductPageContainer" class="py-6 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto" data-product-handle="{{ product.handle }}">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- Left Column: Gallery & LED Simulator Box (5 cols) -->
    <div class="lg:col-span-5 space-y-5">
      
      <!-- Featured Image -->
      <div class="aspect-square bg-gray-50 rounded-3xl overflow-hidden border border-gray-100 shadow-sm relative">
        {%- if product.tags contains 'Bestseller' or product.tags contains 'Best Seller' -%}
          <span class="absolute top-4 left-4 bg-blue-600 text-white text-[10px] font-black px-3 py-1 rounded-full uppercase tracking-wider z-10 shadow">
            ★ BEST SELLER
          </span>
        {%- endif -%}
        <span class="absolute top-11 left-4 bg-gray-900 text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider z-10 shadow">
          500W HEAVY-DUTY LOAD
        </span>
        {%- if product.featured_image != blank -%}
          <img id="MainProductImage" src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title | escape }}" width="1200" height="1200" class="w-full h-full object-cover">
        {%- else -%}
          <img id="MainProductImage" src="https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&q=80&w=1200" alt="{{ product.title | escape }}" width="1200" height="1200" class="w-full h-full object-cover">
        {%- endif -%}
      </div>

      <!-- Thumbnail Gallery Carousel -->
      <div class="grid grid-cols-4 gap-3">
        {%- if product.images.size > 0 -%}
          {%- for image in product.images limit: 4 -%}
            <button type="button" onclick="document.getElementById('MainProductImage').src='{{ image | image_url: width: 1200 }}'" class="aspect-square rounded-2xl overflow-hidden border {% if forloop.first %}border-2 border-blue-600{% else %}border-gray-200{% endif %} focus:outline-none cursor-pointer">
              <img src="{{ image | image_url: width: 300 }}" alt="{{ image.alt | default: product.title | escape }}" width="300" height="300" class="w-full h-full object-cover">
            </button>
          {%- endfor -%}
        {%- else -%}
          <button type="button" onclick="document.getElementById('MainProductImage').src='https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&q=80&w=1200'" class="aspect-square rounded-2xl overflow-hidden border-2 border-blue-600 focus:outline-none cursor-pointer">
            <img src="https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&q=80&w=300" alt="Stair lighting" width="300" height="300" class="w-full h-full object-cover">
          </button>
          <button type="button" onclick="document.getElementById('MainProductImage').src='https://images.unsplash.com/photo-1541123437800-1bb1317badc2?auto=format&fit=crop&q=80&w=1200'" class="aspect-square rounded-2xl overflow-hidden border border-gray-200 focus:outline-none cursor-pointer">
            <img src="https://images.unsplash.com/photo-1541123437800-1bb1317badc2?auto=format&fit=crop&q=80&w=300" alt="Dual sensors" width="300" height="300" class="w-full h-full object-cover">
          </button>
          <button type="button" onclick="document.getElementById('MainProductImage').src='https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&q=80&w=1200'" class="aspect-square rounded-2xl overflow-hidden border border-gray-200 focus:outline-none cursor-pointer">
            <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&q=80&w=300" alt="Interior stairs" width="300" height="300" class="w-full h-full object-cover">
          </button>
          <button type="button" onclick="document.getElementById('MainProductImage').src='https://images.unsplash.com/photo-1507652313519-d4e9174996dd?auto=format&fit=crop&q=80&w=1200'" class="aspect-square rounded-2xl overflow-hidden border border-gray-200 focus:outline-none cursor-pointer">
            <img src="https://images.unsplash.com/photo-1507652313519-d4e9174996dd?auto=format&fit=crop&q=80&w=300" alt="Smart panel" width="300" height="300" class="w-full h-full object-cover">
          </button>
        {%- endif -%}
      </div>

      <!-- Live Simulator Box -->
      <div class="bg-gray-950 text-white rounded-3xl p-6 border border-gray-800 space-y-4 shadow-xl">
        <div class="flex justify-between items-center text-xs">
          <span class="font-black text-blue-400 uppercase tracking-widest flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
            FASTER CONTROLLER LED SIMULATOR
          </span>
          <span class="text-xs bg-green-500/20 text-green-400 font-mono px-2 py-0.5 rounded border border-green-500/30">
            {{ product.variants.first.sku | default: 'LED-2052-V2' }} LIVE
          </span>
        </div>
        <p class="text-[11px] text-gray-400">Test motion triggers for <strong id="SimulatorActiveStepsCount" class="text-white">32 Stair Steps</strong> in real-time:</p>

        <div class="bg-gray-900 p-4 rounded-2xl border border-gray-800">
          <div id="SimulatorStepsGrid" class="grid grid-cols-8 gap-1.5">
            {%- for i in (1..32) -%}
              <div id="sim-step-{{ forloop.index0 }}" class="sim-step-box h-6 rounded bg-gray-800 text-[8px] font-mono flex items-center justify-center text-gray-500 transition-all duration-150">
                {{ i }}
              </div>
            {%- endfor -%}
          </div>
        </div>

        <div class="grid grid-cols-2 gap-2 pt-1">
          <button type="button" id="btn-trigger-bottom" class="py-2.5 px-3 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl shadow transition-all text-center cursor-pointer">
            ► Trigger Bottom PIR
          </button>
          <button type="button" id="btn-trigger-top" class="py-2.5 px-3 bg-gray-800 hover:bg-gray-700 text-white font-bold text-xs rounded-xl shadow transition-all text-center cursor-pointer">
            ► Trigger Top PIR
          </button>
        </div>
      </div>

    </div>

    <!-- Center Column: Specs & Configurator Options (4 cols) -->
    <div class="lg:col-span-4 space-y-5">
      
      <div>
        <div class="flex items-center gap-2 text-[11px] text-blue-600 font-bold uppercase tracking-wider mb-1">
          <span>{{ product.vendor | default: 'Auslese Robotics Series' }}</span>
          <span>•</span>
          <span class="text-gray-500 font-normal">{{ product.variants.first.sku | default: 'LED-2052-V2' }}</span>
        </div>

        <h1 class="text-xl sm:text-2xl font-black text-gray-900 leading-tight">
          {{ product.title }}
        </h1>

        <div class="flex items-center gap-3 text-xs mt-2.5">
          <div class="flex items-center text-amber-400 font-bold">
            <span>★★★★★</span>
            <span class="text-gray-900 ml-1 font-extrabold">4.8</span>
            <span class="text-blue-600 ml-1 hover:underline cursor-pointer">(342 customer reviews)</span>
          </div>
          <span class="text-gray-300">•</span>
          <span class="text-green-600 font-bold">{% if product.available %}In Stock{% else %}Out of Stock{% endif %}</span>
        </div>
      </div>

      <hr class="border-gray-200">

      <!-- Dynamic Pricing Box -->
      <div class="space-y-1">
        <div class="flex items-baseline gap-2">
          <span id="DisplayUnitPrice" class="text-3xl font-black text-gray-900 font-mono tracking-tight">
            ₹{{ product.selected_or_first_available_variant.price | money_without_currency }}
          </span>
          {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
            <span id="DisplayOriginalPrice" class="text-xs text-gray-400 line-through font-mono">
              ₹{{ product.selected_or_first_available_variant.compare_at_price | money_without_currency }}
            </span>
            <span class="bg-red-100 text-red-700 text-[10px] font-black px-2 py-0.5 rounded-full uppercase">
              SAVE 25%
            </span>
          {%- endif -%}
        </div>
        <p class="text-[11px] text-gray-500">Tax included. Free express delivery worldwide.</p>
      </div>

      <!-- Instant Coupon Banner -->
      <div class="p-3.5 rounded-2xl bg-amber-50 border border-amber-200 flex items-center gap-3">
        <input type="checkbox" id="coupon-check" class="w-4 h-4 rounded text-blue-600 focus:ring-blue-500 cursor-pointer">
        <label for="coupon-check" class="text-xs text-amber-950 font-semibold cursor-pointer flex-1">
          <span class="bg-amber-400 text-black px-1.5 py-0.5 rounded text-[10px] font-bold uppercase mr-1">COUPON</span>
          Apply 2% Instant Checkout Discount
        </label>
      </div>

      <!-- Option 1: Package Type -->
      <div class="space-y-2">
        <label class="text-xs font-bold text-gray-900 block">1. Select Package Type:</label>
        <div class="grid grid-cols-2 gap-2 text-xs">
          <button type="button" id="pkg-board" class="pkg-type-btn p-3 rounded-2xl border border-gray-200 text-left transition-all hover:border-gray-300 cursor-pointer">
            <span class="block font-extrabold text-xs text-gray-900">Controller Board</span>
            <span id="pkg-board-subtext" class="text-[10px] text-gray-500">₹2,079 • Board + 2x PIR</span>
          </button>
          <button type="button" id="pkg-kit" class="pkg-type-btn p-3 rounded-2xl border-2 border-blue-600 bg-blue-50/60 text-blue-900 font-bold text-left transition-all shadow-sm cursor-pointer">
            <span class="block font-extrabold text-xs">Complete Step Kit</span>
            <span id="pkg-kit-subtext" class="text-[10px] text-gray-500 font-normal">₹12,479 • includes COB LED</span>
          </button>
        </div>
      </div>

      <!-- Option 2: Configure Steps -->
      <div class="space-y-2">
        <div class="flex justify-between items-center text-xs">
          <span class="font-bold text-gray-900">2. Configure Steps (1 to 32):</span>
          <span id="ConfigStepsLabel" class="text-blue-600 font-mono font-bold">32 Steps</span>
        </div>
        <div class="grid grid-cols-4 gap-1.5 text-xs font-mono">
          <button type="button" class="step-btn py-1.5 px-1 rounded-xl border border-gray-200 text-center text-gray-600 cursor-pointer" data-steps="8">8 Steps</button>
          <button type="button" class="step-btn py-1.5 px-1 rounded-xl border border-gray-200 text-center text-gray-600 cursor-pointer" data-steps="12">12 Steps</button>
          <button type="button" class="step-btn py-1.5 px-1 rounded-xl border border-gray-200 text-center text-gray-600 cursor-pointer" data-steps="16">16 Steps</button>
          <button type="button" class="step-btn py-1.5 px-1 rounded-xl border border-gray-200 text-center text-gray-600 cursor-pointer" data-steps="20">20 Steps</button>
          <button type="button" class="step-btn py-1.5 px-1 rounded-xl border border-gray-200 text-center text-gray-600 cursor-pointer" data-steps="24">24 Steps</button>
          <button type="button" class="step-btn py-1.5 px-1 rounded-xl border border-gray-200 text-center text-gray-600 cursor-pointer" data-steps="28">28 Steps</button>
          <button type="button" class="step-btn active-step py-1.5 px-1 rounded-xl border bg-gray-900 border-gray-900 text-white font-bold text-center cursor-pointer" data-steps="32">32 Steps</button>
        </div>
      </div>

      <!-- Option 3: Operating Voltage -->
      <div class="space-y-2">
        <span class="text-xs font-bold text-gray-900 block">3. Operating Voltage:</span>
        <div class="grid grid-cols-2 gap-2 text-xs">
          <button type="button" class="voltage-btn py-2 px-3 rounded-xl border border-gray-200 text-center text-gray-600 cursor-pointer" data-volt="12V">12V DC Constant Voltage</button>
          <button type="button" class="voltage-btn active-volt py-2 px-3 rounded-xl border-2 border-blue-600 bg-blue-600 text-white font-bold text-center shadow-sm cursor-pointer" data-volt="24V">24V DC Constant Voltage</button>
        </div>
      </div>

      <!-- Option 4: LED Light Warmth -->
      <div class="space-y-2">
        <span class="text-xs font-bold text-gray-900 block">4. LED Light Warmth:</span>
        <div class="grid grid-cols-3 gap-2 text-xs">
          <button type="button" class="warmth-btn active-warmth py-2 px-2 rounded-xl border bg-gray-900 border-gray-900 text-white font-bold text-center cursor-pointer" data-warmth="Warm White">Warm White</button>
          <button type="button" class="warmth-btn py-2 px-2 rounded-xl border border-gray-200 text-center text-gray-600 cursor-pointer" data-warmth="Neutral">Neutral</button>
          <button type="button" class="warmth-btn py-2 px-2 rounded-xl border border-gray-200 text-center text-gray-600 cursor-pointer" data-warmth="Cool White">Cool White</button>
        </div>
      </div>

      <!-- Specs Table -->
      <div class="bg-gray-50 p-4 rounded-2xl border border-gray-200/80 space-y-2 text-xs">
        <div class="flex justify-between border-b border-gray-200 pb-1.5">
          <span class="text-gray-500">Maximum Power Capacity</span>
          <span class="font-bold text-gray-900">500W (3A per step)</span>
        </div>
        <div class="flex justify-between border-b border-gray-200 pb-1.5">
          <span class="text-gray-500">Short Circuit Prevention</span>
          <span class="font-bold text-green-600">✓ Shortcutproof Hardware</span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-500">Sensors Included</span>
          <span class="font-bold text-gray-900">2x PIR Motion Probes</span>
        </div>
      </div>

    </div>

    <!-- Right Column: Sticky Purchasing Box (3 cols) -->
    <div class="lg:col-span-3 bg-white p-6 rounded-3xl border border-gray-200 shadow-xl space-y-5 sticky top-28">
      <div>
        <span id="StickyCalculatedPrice" class="text-3xl font-black text-gray-900 font-mono">
          {{ product.selected_or_first_available_variant.price | money }}
        </span>
        <p class="text-xs text-blue-600 font-semibold mt-1">🚚 Free Express Shipping</p>
        <p class="text-[11px] text-gray-400">Estimated Delivery: <strong>2 to 4 Business Days</strong></p>
        <p class="text-xs text-green-600 font-bold mt-2 flex items-center gap-1">
          ✓ In Stock & Ready to Ship
        </p>
      </div>

      {% form 'product', product, class: 'space-y-4' %}
        <input type="hidden" id="SelectedVariantId" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        
        <!-- Interactive Quantity Controller (+ / -) -->
        <div class="space-y-1">
          <label class="text-xs font-bold text-gray-700">Quantity:</label>
          <div class="w-full flex items-center border border-gray-200 rounded-xl px-3 py-2 justify-between bg-white">
            <button type="button" id="qty-minus" class="w-8 h-8 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold text-base flex items-center justify-center transition-colors cursor-pointer">-</button>
            <input type="number" id="ProductQtyInput" name="quantity" value="1" min="1" readonly class="w-12 text-center font-black text-gray-900 text-base focus:outline-none bg-transparent font-mono">
            <button type="button" id="qty-plus" class="w-8 h-8 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold text-base flex items-center justify-center transition-colors cursor-pointer">+</button>
          </div>
        </div>

        <!-- Protection Plan Checkbox -->
        <div class="p-3 bg-gray-50 rounded-xl border border-gray-200/60 flex items-center gap-2">
          <input type="checkbox" id="plan-check" class="w-4 h-4 rounded text-blue-600 cursor-pointer">
          <label for="plan-check" class="text-[11px] text-gray-700 font-medium cursor-pointer">
            Add 1-Year Hardware Protection Plan (<span id="ProtectionCostText">+₹830</span>)
          </label>
        </div>

        <button type="submit" id="AddToCartBtn" class="w-full py-3.5 bg-[#111111] hover:bg-black text-white font-bold text-xs rounded-xl shadow-lg transition-all flex items-center justify-center gap-2 cursor-pointer">
          <span id="AddToCartBtnText">Add to Cart</span>
        </button>

        <button type="button" id="ExpressBuyNowBtn" class="w-full py-3.5 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl block text-center shadow-lg shadow-blue-500/25 transition-all cursor-pointer">
          Express Buy Now &rarr;
        </button>
      {% endform %}

      <div class="space-y-2 pt-2 border-t border-gray-100 text-[11px] text-gray-500">
        <p class="flex items-center gap-1.5">🔒 256-Bit Encrypted Checkout</p>
        <p class="flex items-center gap-1.5">🛡️ 2-Year Manufacturer Warranty</p>
        <p class="flex items-center gap-1.5">↺ 30-Day Money-Back Guarantee</p>
      </div>
    </div>

  </div>

  <!-- Interactive 5-Tabs Navigation Bar (Matching Screenshots 1, 2, 3) -->
  <div class="mt-16 border-b border-gray-200 overflow-x-auto">
    <div class="flex items-center gap-2 sm:gap-6 text-xs font-bold text-gray-400 uppercase tracking-wider min-w-max pb-1">
      
      <button type="button" class="tab-trigger-btn px-5 py-3 rounded-full bg-gray-900 text-white font-extrabold shadow-sm transition-all cursor-pointer" data-tab="overview">
        OVERVIEW & INCLUDED ITEMS
      </button>

      <button type="button" class="tab-trigger-btn px-5 py-3 rounded-full hover:text-gray-900 hover:bg-gray-100 transition-all cursor-pointer" data-tab="diagram">
        32-CHANNEL TERMINAL DIAGRAM
      </button>

      <button type="button" class="tab-trigger-btn px-5 py-3 rounded-full hover:text-gray-900 hover:bg-gray-100 transition-all cursor-pointer" data-tab="setting">
        5-BUTTON SETTING GUIDE
      </button>

      <button type="button" class="tab-trigger-btn px-5 py-3 rounded-full hover:text-gray-900 hover:bg-gray-100 transition-all cursor-pointer" data-tab="specs">
        FULL SPECIFICATIONS
      </button>

      <button type="button" class="tab-trigger-btn px-5 py-3 rounded-full hover:text-gray-900 hover:bg-gray-100 transition-all cursor-pointer" data-tab="reviews">
        CUSTOMER REVIEWS (3)
      </button>

    </div>
  </div>

  <!-- Tab Contents Area (Dynamic Liquid + Shopify Metafields Call + Screenshots Exact UI) -->
  <div class="py-10">
    
    <!-- TAB 1: OVERVIEW & INCLUDED ITEMS -->
    <div id="tab-content-overview" class="tab-pane-content">
      {%- if product.metafields.custom.overview_html != blank -%}
        {{ product.metafields.custom.overview_html }}
      {%- else -%}
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
          <div class="lg:col-span-7 space-y-6">
            <h3 class="text-2xl font-black text-gray-900">Product Features & Engineering</h3>
            <div class="text-xs sm:text-sm text-gray-600 leading-relaxed space-y-3">
              <p>{{ product.description | default: 'The LuminaStep™ Pro Dual Sensor Kit is engineered for premium home safety and aesthetic sophistication. Featuring dual precision PIR + Microwave radar motion sensors at top and bottom landings, it triggers a seamless step-by-step cascade effect as you walk. Includes ultra-dense COB LED strips, intelligent master controller box with adjustable speed, brightness, and stay-on timer.' }}</p>
            </div>

            <h4 class="text-sm font-extrabold text-gray-900 pt-2">Key Controller Highlights:</h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="p-4 rounded-2xl bg-gray-50 border border-gray-100 flex items-start gap-3">
                <span class="text-blue-600 font-bold">✓</span>
                <span class="text-xs text-gray-700">Dual PIR + Microwave motion radar sensors for zero false triggers</span>
              </div>
              <div class="p-4 rounded-2xl bg-gray-50 border border-gray-100 flex items-start gap-3">
                <span class="text-blue-600 font-bold">✓</span>
                <span class="text-xs text-gray-700">Step-by-step sequential cascade illumination effect</span>
              </div>
              <div class="p-4 rounded-2xl bg-gray-50 border border-gray-100 flex items-start gap-3">
                <span class="text-blue-600 font-bold">✓</span>
                <span class="text-xs text-gray-700">COB High-Density LED Strips (No visible hot spots)</span>
              </div>
              <div class="p-4 rounded-2xl bg-gray-50 border border-gray-100 flex items-start gap-3">
                <span class="text-blue-600 font-bold">✓</span>
                <span class="text-xs text-gray-700">Adjustable cascading speed (0.2s - 2.0s per step)</span>
              </div>
              <div class="p-4 rounded-2xl bg-gray-50 border border-gray-100 flex items-start gap-3">
                <span class="text-blue-600 font-bold">✓</span>
                <span class="text-xs text-gray-700">Smart ambient light sensor disables trigger during bright daylight</span>
              </div>
              <div class="p-4 rounded-2xl bg-gray-50 border border-gray-100 flex items-start gap-3">
                <span class="text-blue-600 font-bold">✓</span>
                <span class="text-xs text-gray-700">Supports 1 to 32 steps with expander module support</span>
              </div>
            </div>
          </div>

          <!-- Package Includes Dark Card -->
          <div class="lg:col-span-5 bg-gray-950 text-white rounded-3xl p-8 border border-gray-800 shadow-xl space-y-5">
            <h3 class="text-lg font-bold text-white flex items-center gap-2">
              <span>🎁</span> Package Includes
            </h3>
            <ul class="space-y-3.5 text-xs text-gray-300">
              <li class="flex items-start gap-3"><span class="text-blue-400 font-bold">✓</span><span>2x Precision Smart Motion Sensor Pods (Top & Bottom)</span></li>
              <li class="flex items-start gap-3"><span class="text-blue-400 font-bold">✓</span><span>1x LuminaStep™ Master Cascading Controller</span></li>
              <li class="flex items-start gap-3"><span class="text-blue-400 font-bold">✓</span><span>16x Pre-cut COB LED Light Strips (1.0m / 3.3ft each)</span></li>
              <li class="flex items-start gap-3"><span class="text-blue-400 font-bold">✓</span><span>1x 100W 24V Ultra-Quiet Power Supply Adapter</span></li>
              <li class="flex items-start gap-3"><span class="text-blue-400 font-bold">✓</span><span>1x Complete Wire Harness with Quick-Connect Snap Terminals</span></li>
              <li class="flex items-start gap-3"><span class="text-blue-400 font-bold">✓</span><span>3M VHB Heavy-Duty Adhesive Pads & Screw Hardware</span></li>
              <li class="flex items-start gap-3"><span class="text-blue-400 font-bold">✓</span><span>Comprehensive Illustrated Installation & Wiring Manual</span></li>
            </ul>
          </div>
        </div>
      {%- endif -%}
    </div>

    <!-- TAB 2: 32-CHANNEL TERMINAL DIAGRAM (Matching Screenshot 1) -->
    <div id="tab-content-diagram" class="tab-pane-content hidden">
      {%- if product.metafields.custom.terminal_diagram_html != blank -%}
        {{ product.metafields.custom.terminal_diagram_html }}
      {%- else -%}
        <div class="space-y-6">
          <div class="space-y-1">
            <span class="text-xs font-black text-blue-600 uppercase tracking-widest">INSTALLATION LAYOUT</span>
            <h3 class="text-2xl font-black text-gray-900">32-Channel Screw Terminal Block Map</h3>
            <p class="text-xs text-gray-500">Each stair step connects directly to its corresponding shortcutproof output terminal on the LED-2052-V2 board.</p>
          </div>

          <!-- Dark Map Card Container -->
          <div class="bg-gray-950 text-white p-8 rounded-3xl border border-gray-800 shadow-2xl space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              
