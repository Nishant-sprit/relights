<!-- Return & Warranty Policy Hero Header -->
<div class="py-12 sm:py-16 bg-white text-center border-b border-gray-100 px-4">
  <div class="max-w-4xl mx-auto space-y-3">
    <span class="text-xs font-black text-blue-600 uppercase tracking-widest block font-mono">
      RISK-FREE GUARANTEE
    </span>
    <h1 class="text-3xl sm:text-5xl font-black text-gray-900 tracking-tight">
      Return & <span class="bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">Warranty Policy</span>
    </h1>
    <p class="text-xs sm:text-base text-gray-500 max-w-2xl mx-auto leading-relaxed">
      At LuminaStep™, we stand behind the engineering of our smart staircase motion lighting kits. Every purchase is backed by our 30-Day Money-Back Guarantee and 2 to 3-Year Replacement Warranty.
    </p>
  </div>
</div>

<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto space-y-10">

  <!-- Top 3 Guarantee Feature Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="p-6 rounded-3xl bg-neutral-950 text-white border border-neutral-800 space-y-2 text-center shadow-xl">
      <div class="w-10 h-10 rounded-xl bg-blue-600/20 text-blue-400 flex items-center justify-center mx-auto mb-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
      </div>
      <h3 class="text-base font-bold text-white">30-Day Return Window</h3>
      <p class="text-xs text-neutral-400">100% money back guarantee</p>
    </div>

    <div class="p-6 rounded-3xl bg-neutral-950 text-white border border-neutral-800 space-y-2 text-center shadow-xl">
      <div class="w-10 h-10 rounded-xl bg-indigo-600/20 text-indigo-400 flex items-center justify-center mx-auto mb-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
      </div>
      <h3 class="text-base font-bold text-white">2–3 Year Warranty</h3>
      <p class="text-xs text-neutral-400">Free unit/hardware replacement</p>
    </div>

    <div class="p-6 rounded-3xl bg-neutral-950 text-white border border-neutral-800 space-y-2 text-center shadow-xl">
      <div class="w-10 h-10 rounded-xl bg-emerald-600/20 text-emerald-400 flex items-center justify-center mx-auto mb-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
      <h3 class="text-base font-bold text-white">3–5 Day Refunds</h3>
      <p class="text-xs text-neutral-400">Fast bank statement processing</p>
    </div>
  </div>

  <!-- Detailed Policy Breakdown Blocks -->
  <div class="space-y-6">
    
    <!-- Section 1 -->
    <div class="p-6 sm:p-8 rounded-3xl bg-neutral-950 border border-neutral-800 text-white space-y-4 shadow-xl">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-xl bg-blue-600 flex items-center justify-center text-white font-bold text-xs">1</div>
        <h2 class="text-xl font-bold text-white">30-Day Money Back Return Window</h2>
      </div>
      <div class="text-xs text-neutral-300 space-y-3 leading-relaxed pl-11">
        <p>You may return any undamaged or line-item LuminaStep™ Smart Motion Lighting Kit within <strong>30 days of delivery</strong> for a full refund of the purchase price.</p>
        <ul class="list-disc pl-4 space-y-1.5 text-neutral-400">
          <li>Products must include all original master controller components, power adapters, LED light strips, and sensor probes.</li>
          <li>Items damaged or modified return beyond normal testing/trial are not eligible for partial/full reimbursement.</li>
          <li>Return shipping labels are provided free for defective items or order exchanges.</li>
        </ul>
      </div>
    </div>

    <!-- Section 2 -->
    <div class="p-6 sm:p-8 rounded-3xl bg-neutral-950 border border-neutral-800 text-white space-y-4 shadow-xl">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-xl bg-indigo-600 flex items-center justify-center text-white font-bold text-xs">2</div>
        <h2 class="text-xl font-bold text-white">2 to 3-Year Replacement Warranty</h2>
      </div>
      <p class="text-xs text-neutral-300 leading-relaxed pl-11">
        All LuminaStep™ products carry a comprehensive warranty covering manufacturing defects, power supply failures, or sensor sensitivity degradation.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pl-11 pt-2">
        <div class="p-4 rounded-2xl bg-neutral-900 border border-neutral-800 space-y-1">
          <h4 class="font-bold text-xs text-white">LuminaStep Pro & Recessed Kits</h4>
          <p class="text-[11px] text-neutral-400">2-Year Full Hardware Replacement Warranty covering all sensors, controllers, and COB light strips.</p>
        </div>
        <div class="p-4 rounded-2xl bg-neutral-900 border border-neutral-800 space-y-1">
          <h4 class="font-bold text-xs text-white">LuminaStep Ultra RGB-W System</h4>
          <p class="text-[11px] text-neutral-400">3-Year Extended Warranty covering Bluetooth master controllers, app connectivity, and power drivers.</p>
        </div>
      </div>
    </div>

    <!-- Section 3 -->
    <div class="p-6 sm:p-8 rounded-3xl bg-neutral-950 border border-neutral-800 text-white space-y-4 shadow-xl">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-xl bg-amber-600 flex items-center justify-center text-white font-bold text-xs">3</div>
        <h2 class="text-xl font-bold text-white">Damaged or Missing Product Process</h2>
      </div>
      <div class="text-xs text-neutral-300 space-y-3 leading-relaxed pl-11">
        <p>In the rare event that your shipment arrives with shipping damage or missing wire harnesses:</p>
        <ol class="list-decimal pl-4 space-y-1.5 text-neutral-400">
          <li>Take a quick photo/video of the parcel and defective item.</li>
          <li>Email our support team at <a href="mailto:support@luminastep.com" class="text-blue-400 font-bold underline">support@luminastep.com</a> or WhatsApp <a href="https://wa.me/14158903312" class="text-emerald-400 font-bold underline">+1 (415) 890-3312</a>.</li>
          <li>We will dispatch a replacement component within 24 hours with zero additional charges.</li>
        </ol>
      </div>
    </div>

    <!-- Section 4 -->
    <div class="p-6 sm:p-8 rounded-3xl bg-neutral-950 border border-neutral-800 text-white space-y-4 shadow-xl">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-xl bg-emerald-600 flex items-center justify-center text-white font-bold text-xs">4</div>
        <h2 class="text-xl font-bold text-white">Refund Timeline & Shipping Fees</h2>
      </div>
      <div class="text-xs text-neutral-300 space-y-2 leading-relaxed pl-11">
        <p>Once your returned package is received at our San Francisco distribution center, our team inspects the kit and issues your refund within 24 to 48 hours.</p>
        <p class="text-neutral-400">Depending on your financial institution, funds will appear back on your credit card or payment statement within 3 to 5 business days.</p>
      </div>
    </div>

  </div>

  <!-- Bottom CTA Box -->
  <div class="p-8 sm:p-10 rounded-3xl bg-neutral-950 border border-neutral-800 text-center space-y-4 shadow-2xl">
    <h3 class="text-xl font-black text-white">Need Help Starting a Return or Warranty Claim?</h3>
    <p class="text-xs text-neutral-400 max-w-md mx-auto">Our support engineers are ready to assist you with order authorization & return labels.</p>
    <a href="/pages/contact" class="inline-flex items-center gap-2 px-6 py-3.5 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl shadow-lg transition-all">
      <span>Contact Customer Support &rarr;</span>
    </a>
  </div>

</section>

