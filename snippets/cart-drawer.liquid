<div id="CartDrawer" class="cart-drawer-overlay fixed inset-0 z-50 invisible opacity-0 transition-all duration-300">
  <div class="cart-drawer-backdrop absolute inset-0 bg-slate-950/80 backdrop-blur-sm"></div>

  <div class="cart-drawer-content absolute right-0 top-0 bottom-0 w-full max-w-md bg-slate-900 border-l border-slate-800 shadow-2xl flex flex-col transform translate-x-full transition-transform duration-300">
    <div class="flex items-center justify-between p-5 border-b border-slate-800">
      <h2 class="text-xl font-extrabold text-slate-100 flex items-center gap-2">
        <span>Your Shopping Cart</span>
        <span class="cart-count-badge text-xs bg-amber-500 text-slate-950 font-extrabold px-2 py-0.5 rounded-full">
          {{ cart.item_count }}
        </span>
      </h2>

      <button id="CloseCartDrawer" class="p-2 rounded-lg text-slate-400 hover:text-slate-100 hover:bg-slate-800 transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <div class="cart-drawer-items flex-1 overflow-y-auto p-5 space-y-4" id="CartDrawerItems">
      {% if cart.item_count > 0 %}
        {% for item in cart.items %}
          <div class="flex gap-4 p-3 rounded-xl bg-slate-950/50 border border-slate-800/80">
            <div class="w-20 h-20 rounded-lg overflow-hidden bg-slate-800 flex-shrink-0">
              <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" class="w-full h-full object-cover">
            </div>
            <div class="flex-1 flex flex-col justify-between">
              <div>
                <h4 class="font-semibold text-slate-100 text-sm line-clamp-1">{{ item.product.title }}</h4>
                <p class="text-xs text-slate-400">{{ item.variant.title }}</p>
              </div>
              <div class="flex items-center justify-between mt-2">
                <span class="text-sm font-bold text-amber-400">{{ item.final_price | money }}</span>
                <span class="text-xs text-slate-400">Qty: {{ item.quantity }}</span>
              </div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <div class="text-center py-12 text-slate-400">
          <p class="text-lg">Your cart is empty.</p>
          <a href="/collections/all" class="mt-4 inline-block text-amber-400 font-semibold underline">Browse Products</a>
        </div>
      {% endif %}
    </div>

    <div class="p-5 border-t border-slate-800 bg-slate-950/60">
      <div class="flex justify-between text-base font-bold text-slate-100 mb-4">
        <span>Subtotal</span>
        <span class="cart-drawer-subtotal text-amber-400">{{ cart.total_price | money }}</span>
      </div>

      <a href="/checkout" class="w-full block text-center bg-gradient-to-r from-amber-500 to-amber-400 text-slate-950 font-extrabold py-3.5 px-6 rounded-xl hover:from-amber-400 hover:to-amber-300 shadow-lg transition-all">
        Proceed to Checkout
      </a>
    </div>
  </div>
</div>
