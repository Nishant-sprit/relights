<div class="bg-white border border-gray-100 rounded-3xl p-6 shadow-sm hover:shadow-xl transition-all flex flex-col justify-between group">
  <div>
    <a href="{{ product.url }}" class="block relative aspect-square bg-gray-50 rounded-2xl overflow-hidden mb-5">
      {%- if product.featured_image != blank -%}
        <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" height="600" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
      {%- else -%}
        <div class="w-full h-full flex items-center justify-center text-gray-400 bg-gray-100">No Image</div>
      {%- endif -%}
    </a>

    <a href="{{ product.url }}">
      <h3 class="font-bold text-lg text-gray-900 group-hover:text-blue-600 transition-colors line-clamp-2">{{ product.title }}</h3>
    </a>
    <p class="text-xs text-gray-500 mt-1 line-clamp-2">{{ product.description | strip_html | truncate: 90 }}</p>
  </div>

  <div class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between">
    <div>
      <span class="text-xl font-extrabold text-gray-900">{{ product.price | money }}</span>
      {%- if product.compare_at_price > product.price -%}
        <span class="text-xs text-gray-400 line-through ml-2">{{ product.compare_at_price | money }}</span>
      {%- endif -%}
    </div>

    <form method="post" action="{{ routes.cart_add_url }}" class="quick-add-form">
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <button type="submit" class="px-5 py-2.5 bg-gray-900 hover:bg-black text-white font-bold rounded-xl text-xs flex items-center gap-2 transition-all">
        <span>Add to Cart</span>
      </button>
    </form>
  </div>
</div>
