{% comment %}
  Renders a Shopify product card with Ajax add-to-cart functionality
  Usage:
  {% render 'product-card', product: product %}
{% endcomment %}

<div class="product-card group relative flex flex-col rounded-2xl border border-slate-800 bg-slate-900/80 backdrop-blur-md overflow-hidden transition-all duration-300 hover:border-amber-500/50 hover:shadow-[0_0_30px_rgba(245,158,11,0.15)]">
  <div class="aspect-square w-full overflow-hidden bg-slate-950/60 relative">
    {% if product.featured_media %}
      <img
        src="{{ product.featured_media | image_url: width: 600 }}"
        alt="{{ product.featured_media.alt | escape }}"
        loading="lazy"
        width="600"
        height="600"
        class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
      >
    {% else %}
      <div class="flex h-full w-full items-center justify-center bg-slate-800 text-slate-500">
        No Image
      </div>
    {% endif %}

    {% if product.compare_at_price > product.price %}
      <span class="absolute top-3 left-3 rounded-full bg-gradient-to-r from-amber-500 to-orange-600 px-3 py-1 text-xs font-bold text-slate-950 uppercase tracking-wider shadow-lg">
        Sale
      </span>
    {% endif %}
  </div>

  <div class="flex flex-1 flex-col p-5">
    <span class="text-xs font-semibold text-amber-400 uppercase tracking-widest mb-1">
      {{ product.vendor | default: 'Relights' }}
    </span>

    <h3 class="text-lg font-bold text-slate-100 group-hover:text-amber-400 transition-colors line-clamp-1">
      <a href="{{ product.url }}">
        {{ product.title }}
      </a>
    </h3>

    <p class="mt-2 text-sm text-slate-400 line-clamp-2 flex-1">
      {{ product.description | strip_html | truncatewords: 15 }}
    </p>

    <div class="mt-4 flex items-center justify-between">
      <div class="flex items-baseline space-x-2">
        <span class="text-xl font-extrabold text-slate-100">
          {{ product.price | money }}
        </span>
        {% if product.compare_at_price > product.price %}
          <span class="text-sm text-slate-500 line-through">
            {{ product.compare_at_price | money }}
          </span>
        {% endif %}
      </div>

      <form method="post" action="/cart/add" data-ajax-cart-form class="inline-block">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button
          type="submit"
          class="rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 px-4 py-2 text-sm font-bold transition-all shadow-md hover:shadow-amber-500/25 flex items-center gap-1.5"
          {% unless product.available %}disabled{% endunless %}
        >
          {% if product.available %}
            Add to Cart
          {% else %}
            Sold Out
          {% endif %}
        </button>
      </form>
    </div>
  </div>
</div>
